rules_version = '2';
// Each browser signs in anonymously and may only touch documents carrying its own uid.
// The scheduler uses the Admin SDK, which is not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function mine(id) { return signedIn() && id.matches(request.auth.uid + '_.*'); }

    match /devices/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if mine(id)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'token', 'lang', 'tz', 'updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() < 400
        && request.resource.data.lang in ['ar', 'en']
        && request.resource.data.tz is string && request.resource.data.tz.size() < 64
        && (resource == null || resource.data.uid == request.auth.uid);
    }

    match /reminders/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if mine(id)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'taskId', 'key', 'kind', 'minutes', 'title', 'dueAt', 'dueDay', 'fireAt', 'tz'])
        && request.resource.data.taskId is string && request.resource.data.taskId.size() < 100
        && request.resource.data.key is string && request.resource.data.key.size() < 40
        && request.resource.data.kind in ['before', 'custom', 'test']
        && request.resource.data.title is string && request.resource.data.title.size() < 300
        && request.resource.data.fireAt is number
        && request.resource.data.tz is string && request.resource.data.tz.size() < 64
        && (resource == null || resource.data.uid == request.auth.uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
